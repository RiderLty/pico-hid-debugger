+// 恢复被"锁偏 k bit"破坏的 2 字节应答包（SYNC + 握手 PID）。
+//
+// 上游 #97（2023 年至今 open）的现场就是 0x80 0xD2（SYNC+ACK）被解成 0x01 0xA5，
+// PR #211 为此加了确定性重对齐，但只覆盖 receive_packet_and_handshake 里
+// idx>=4 的数据包——2 字节握手包（ACK/NAK/STALL）走的是 wait_handshake，
+// 认不出就返回 0（"invalid handshake"），SETUP/OUT 于是被误判成"对端没应答"，
+// 端点随后卡死。实测 RP2350 + hub 下的 SETUP 失败正是这个形态：
+// [PIODBG] kind=SETUP res=-1 sync=01 pid=A5。
+//
+// 恢复方式与 PR #211 同一套：按 SYNC(0x80) 标记逐个试位移 k，再用 PID 的
+// 校验半字节确认。注意进位方向：被破坏的字节 b[i] = orig[i]<<k | orig[i-1]>>(8-k)
+// 形式的左移，所以 orig[i] = b[i]>>k | b[i-1]<<(8-k)；包首之前是空闲态（J=1），
+// 用它补 b[0] 的高位。返回恢复出的 PID，0 表示无法恢复。
+static uint8_t __not_in_flash_func(pio_usb_recover_short_packet)(
+    const uint8_t *buf) {
+  for (uint8_t k = 1; k <= 7; k++) {
+    uint8_t const sync = (uint8_t)((buf[0] >> k) | (0xFFu << (8 - k)));
+    if (sync != USB_SYNC) {
+      continue;
+    }
+    uint8_t const pid = (uint8_t)((buf[1] >> k) | (buf[0] << (8 - k)));
+    if (((pid >> 4) ^ (pid & 0x0f)) == 0x0f) { // PID 校验半字节合法
+      return pid;
+    }
+  }
+  return 0;
+}
