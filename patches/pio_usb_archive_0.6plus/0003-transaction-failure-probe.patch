+//--------------------------------------------------------------------
+// 事务失败探针（本地补丁 0003，定义在 pio_usb_host.c）
+// 每种事务各留一份未读取样本；应用侧读 pio_usb_dbg_last[k] 后清
+// pio_usb_dbg_pending 的对应位。判读说明见 pio_usb_host.c。
+//--------------------------------------------------------------------
+typedef struct {
+  uint8_t kind;     // 0=IN 1=OUT 2=SETUP
+  uint8_t ep;       // 端点号（含方向位）
+  int8_t res;       // -1: 有 EOP 但非 ACK/NAK/STALL；-2: 无 EOP
+  uint8_t started;  // 响应是否真的开始（wait_for_rx_start 结果）
+  uint8_t sync;     // 收到包首字节（正常 0x80 SYNC；0=什么都没收到）
+  uint8_t pid;      // PID 字节（ACK=0xD2 NAK=0x5A STALL=0x1E）
+  uint8_t retry;    // 失败时重试计数
+  uint32_t seq;     // 样本序号
+} pio_usb_dbg_sample_t;
+
+extern volatile pio_usb_dbg_sample_t pio_usb_dbg_last[3];
+extern volatile uint8_t pio_usb_dbg_pending;
+extern volatile uint8_t pio_usb_dbg_started;
+extern volatile uint32_t pio_usb_dbg_attempt[3];
+extern volatile uint32_t pio_usb_dbg_seq;
